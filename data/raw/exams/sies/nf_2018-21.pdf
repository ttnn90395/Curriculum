</div>
<div class="modal" id="modal-slider">
    <div class="modal-content modal-slide" >
        <ul>
            <li>
                <span class="span1">Dyslexie</span>
                <label class="switch"  for="switch-accessibility-dyslexia">
                    <input class="switch-accessibility" data-key="dyslexia" type="checkbox" id="switch-accessibility-dyslexia"/>
                    <div class="slider round"></div>
                </label>
            </li>
            <li>
                <span class="span1">Contraste</span>
                <label class="switch" for="switch-accessibility-contrast">
                    <input class="switch-accessibility" data-key="contrast" type="checkbox" id="switch-accessibility-contrast"/>
                    <div class="slider round"></div>
                </label>
            </li>
        </ul>
    </div>
</div>
